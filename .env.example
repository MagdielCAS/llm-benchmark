# External Scorer Settings
# If true, the system will use the OpenRouter API for scoring instead of local LLMs
EXTERNAL_SCORER_ENABLED=false
OPENROUTER_API_KEY=your_api_key_here
EXTERNAL_SCORER_MODEL=google/gemini-2.5-pro

# PDF Export
# If true, the markdown report will also be exported as a PDF
EXPORT_PDF=false
